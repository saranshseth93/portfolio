// Personal motto. The Sanskrit is the main line; the English gives the meaning and the
// Hindi echoes it. Colours come from the same theme tokens as the rest of the page, so the
// band recolours with every theme instead of sitting apart from it.
---
<section id="motto" class="motto" aria-label="Motto">
  <div class="motto-inner" data-motto>
    <p class="motto-sa" lang="sa">!! आत्मनः उन्नयन प्रति ध्यांन न सिद्ध्य !!</p>
    <p class="motto-en">Focus on improving yourself, not proving yourself.</p>
    <p class="motto-hi" lang="hi">( खुद को बेहतर बनाने पर ध्यान दे ना कि साबित करने पर )</p>
  </div>
</section>
